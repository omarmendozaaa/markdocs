{
  "name": "markdocs",
  "version": "0.2.0",
  "description": "Convierte PDF, Word, Excel, PowerPoint, HTML e imágenes a Markdown en tu equipo, con Docling. Para Linux, macOS y Windows.",
  "main": "./out/main/index.js",
  "author": "Markdocs contributors",
  "license": "MIT",
  "homepage": "https://github.com/omarmendozaaa/markdocs",
  "repository": {
    "type": "git",
    "url": "https://github.com/omarmendozaaa/markdocs.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "fetch-uv": "node scripts/fetch-uv.mjs",
    "e2e": "node scripts/e2e.mjs",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "dompurify": "^3.4.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "marked": "^18.0.0",
    "playwright-core": "^1.65.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "io.github.omarmendozaaa.markdocs",
    "productName": "Markdocs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "uv*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "synopsis": "Convierte documentos a Markdown"
    },
    "artifactName": "Markdocs-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-"
    }
  }
}
